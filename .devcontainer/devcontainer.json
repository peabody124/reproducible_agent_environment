{
  "name": "Reproducible Agent Environment (GPU)",

  "image": "nvidia/cuda:12.6.0-cudnn-devel-ubuntu24.04",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {}
  },

  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=/mnt/CottonLab/datasets,target=/mnt/CottonLab/datasets,type=bind,readonly"
  ],

  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1 libegl1 libvulkan1 libglib2.0-0 libosmesa6-dev git-lfs && sudo mkdir -p /usr/share/glvnd/egl_vendor.d /etc/vulkan/icd.d && printf '{\"file_format_version\":\"1.0.0\",\"ICD\":{\"library_path\":\"libEGL_nvidia.so.0\"}}\\n' | sudo tee /usr/share/glvnd/egl_vendor.d/10_nvidia.json >/dev/null && printf '{\"file_format_version\":\"1.0.0\",\"ICD\":{\"library_path\":\"libGLX_nvidia.so.0\",\"api_version\":\"1.3\"}}\\n' | sudo tee /etc/vulkan/icd.d/nvidia_icd.json >/dev/null && sudo rm -rf /var/lib/apt/lists/* && (git lfs install --force || true)",
  "postCreateCommand": "./scripts/install-user.sh",

  "containerEnv": {
    "RAE_VERSION": "main",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "ENABLE_LSP_TOOL": "1",
    "CUDA_DEVICE_ORDER": "PCI_BUS_ID",
    "CUDA_VISIBLE_DEVICES": "-1",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics",
    "PYOPENGL_PLATFORM": "egl",
    "MUJOCO_GL": "egl",
    "GIT_LFS_SKIP_SMUDGE": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "ms-toolsai.jupyter",
        "github.copilot"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "none",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        },
        "ruff.format.args": [],
        "ruff.lint.args": [],
        "editor.rulers": [120],
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "python.testing.pytestPath": "/usr/local/bin/pytest",
        "python.testing.pytestEnabled": true
      }
    }
  },

  "runArgs": [
    "--env-file",
    ".env",
    "--gpus",
    "all",
    "-e",
    "NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics"
  ],

  "remoteUser": "vscode"
}
